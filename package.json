{
  "name": "aulanorma",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.21.0 <25",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=11.19.0 <12",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=24.21.0 <25",
    "npm": ">=11.19.0 <12"
  },
  "scripts": {
    "dev": "NODE_ENV=development TURBOPACK= IS_TURBOPACK_TEST= NEXT_RSPACK= node scripts/preflight.mjs dev && NEXT_TELEMETRY_DISABLED=1 NODE_ENV=development TURBOPACK= IS_TURBOPACK_TEST= NEXT_RSPACK= node server.mjs",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "NODE_ENV=production node scripts/preflight.mjs start && NEXT_TELEMETRY_DISABLED=1 NODE_ENV=production node server.mjs",
    "format": "prettier --write .",
    "check:format": "prettier --check .",
    "check:lint": "eslint . --max-warnings=0",
    "check:types": "NEXT_TELEMETRY_DISABLED=1 next typegen && tsc --noEmit",
    "check:test": "vitest run",
    "check:build": "NEXT_TELEMETRY_DISABLED=1 next build && node scripts/smoke-test.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:deps": "node scripts/check-dependencies.mjs",
    "check:workflows": "node scripts/check-workflows.mjs",
    "check:quality": "npm run check:format && npm run check:lint && npm run check:types && npm run check:test && npm run check:build",
    "check:security": "npm run check:secrets && npm run check:deps && npm run check:workflows",
    "check": "npm run check:quality && npm run check:security",
    "tools:install": "node scripts/tools/install-tools.mjs",
    "verify:negative": "node scripts/negative-checks.mjs"
  },
  "dependencies": {
    "@next/env": "16.3.8",
    "fflate": "0.8.3",
    "next": "16.3.8",
    "pdfjs-dist": "6.4.299",
    "pino": "10.3.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "eslint": "10.11.0",
    "jsdom": "30.1.2",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
